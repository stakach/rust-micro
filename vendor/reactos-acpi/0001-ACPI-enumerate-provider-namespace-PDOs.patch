diff --git a/drivers/bus/acpi/namespace.c b/drivers/bus/acpi/namespace.c
new file mode 100644
index 00000000..6c4168f1
--- /dev/null
+++ b/drivers/bus/acpi/namespace.c
@@ -0,0 +1,317 @@
+#include "precomp.h"
+
+#define NDEBUG
+#include <debug.h>
+
+#define ACPI_ENUM_POOL_TAG 'nEcA'
+#define ACPI_ENUM_OUTPUT_HEADER_SIZE FIELD_OFFSET(ACPI_ENUM_CHILDREN_OUTPUT_BUFFER, Children)
+#define ACPI_ENUM_RECORD_HEADER_SIZE FIELD_OFFSET(ACPI_ENUM_CHILD, Name)
+#define ACPI_ENUM_KNOWN_FLAGS \
+    (ENUM_CHILDREN_IMMEDIATE_ONLY | ENUM_CHILDREN_MULTILEVEL | ENUM_CHILDREN_NAME_IS_FILTER)
+
+typedef struct _ACPI_ENUM_ENTRY
+{
+    LIST_ENTRY Link;
+    ULONG Flags;
+    ULONG NameLength;
+    CHAR Name[ANYSIZE_ARRAY];
+} ACPI_ENUM_ENTRY, *PACPI_ENUM_ENTRY;
+
+typedef struct _ACPI_ENUM_CONTEXT
+{
+    LIST_ENTRY Entries;
+    NTSTATUS Status;
+    ULONG RequiredLength;
+    ULONG Count;
+    BOOLEAN Filtered;
+    CHAR Filter[ACPI_NAMESEG_SIZE + 1];
+} ACPI_ENUM_CONTEXT, *PACPI_ENUM_CONTEXT;
+
+static
+VOID
+AcpiEnumFreeEntries(
+    PACPI_ENUM_CONTEXT Context)
+{
+    PLIST_ENTRY Link;
+    PACPI_ENUM_ENTRY Entry;
+
+    while (!IsListEmpty(&Context->Entries))
+    {
+        Link = RemoveHeadList(&Context->Entries);
+        Entry = CONTAINING_RECORD(Link, ACPI_ENUM_ENTRY, Link);
+        ExFreePoolWithTag(Entry, ACPI_ENUM_POOL_TAG);
+    }
+}
+
+static
+ACPI_STATUS
+AcpiEnumCaptureObject(
+    ACPI_HANDLE Object,
+    UINT32 NestingLevel,
+    void *RawContext,
+    void **ReturnValue)
+{
+    PACPI_ENUM_CONTEXT Context = RawContext;
+    ACPI_BUFFER Path = {ACPI_ALLOCATE_BUFFER, NULL};
+    ACPI_HANDLE Child;
+    ACPI_STATUS AcpiStatus;
+    PACPI_ENUM_ENTRY Entry;
+    SIZE_T NameLength;
+    SIZE_T AllocationLength;
+    ULONG RecordLength;
+    ULONG NewRequiredLength;
+    CHAR Name[ACPI_NAMESEG_SIZE + 1] = {0};
+    ACPI_BUFFER NameBuffer = {sizeof(Name), Name};
+
+    UNREFERENCED_PARAMETER(NestingLevel);
+    UNREFERENCED_PARAMETER(ReturnValue);
+
+    if (Context->Filtered)
+    {
+        AcpiStatus = AcpiGetName(Object, ACPI_SINGLE_NAME, &NameBuffer);
+        if (ACPI_FAILURE(AcpiStatus))
+        {
+            Context->Status = AcpiStatus == AE_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES
+                                                         : STATUS_INVALID_DEVICE_REQUEST;
+            return AE_CTRL_TERMINATE;
+        }
+        if (RtlCompareMemory(Name, Context->Filter, ACPI_NAMESEG_SIZE) != ACPI_NAMESEG_SIZE ||
+            Name[ACPI_NAMESEG_SIZE] != ANSI_NULL)
+        {
+            return AE_OK;
+        }
+    }
+
+    AcpiStatus = AcpiGetName(Object, ACPI_FULL_PATHNAME, &Path);
+    if (ACPI_FAILURE(AcpiStatus) || !Path.Pointer)
+    {
+        Context->Status = AcpiStatus == AE_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES
+                                                     : STATUS_INVALID_DEVICE_REQUEST;
+        return AE_CTRL_TERMINATE;
+    }
+
+    NameLength = strlen(Path.Pointer) + sizeof(ANSI_NULL);
+    if (NameLength > MAXULONG ||
+        !NT_SUCCESS(RtlULongAdd(ACPI_ENUM_RECORD_HEADER_SIZE,
+                               (ULONG)NameLength,
+                               &RecordLength)) ||
+        !NT_SUCCESS(RtlULongAdd(Context->RequiredLength,
+                               RecordLength,
+                               &NewRequiredLength)) ||
+        Context->Count == MAXULONG)
+    {
+        AcpiOsFree(Path.Pointer);
+        Context->Status = STATUS_INTEGER_OVERFLOW;
+        return AE_CTRL_TERMINATE;
+    }
+    AllocationLength = FIELD_OFFSET(ACPI_ENUM_ENTRY, Name) + NameLength;
+    if (AllocationLength < NameLength)
+    {
+        AcpiOsFree(Path.Pointer);
+        Context->Status = STATUS_INTEGER_OVERFLOW;
+        return AE_CTRL_TERMINATE;
+    }
+
+    Entry = ExAllocatePoolWithTag(PagedPool, AllocationLength, ACPI_ENUM_POOL_TAG);
+    if (!Entry)
+    {
+        AcpiOsFree(Path.Pointer);
+        Context->Status = STATUS_INSUFFICIENT_RESOURCES;
+        return AE_CTRL_TERMINATE;
+    }
+    AcpiStatus = AcpiGetNextObject(ACPI_TYPE_ANY, Object, NULL, &Child);
+    if (ACPI_FAILURE(AcpiStatus) && AcpiStatus != AE_NOT_FOUND)
+    {
+        ExFreePoolWithTag(Entry, ACPI_ENUM_POOL_TAG);
+        AcpiOsFree(Path.Pointer);
+        Context->Status = AcpiStatus == AE_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES
+                                                     : STATUS_INVALID_DEVICE_REQUEST;
+        return AE_CTRL_TERMINATE;
+    }
+    Entry->Flags = ACPI_SUCCESS(AcpiStatus) ? ACPI_OBJECT_HAS_CHILDREN : 0;
+    Entry->NameLength = (ULONG)NameLength;
+    RtlCopyMemory(Entry->Name, Path.Pointer, NameLength);
+    AcpiOsFree(Path.Pointer);
+
+    InsertTailList(&Context->Entries, &Entry->Link);
+    Context->RequiredLength = NewRequiredLength;
+    Context->Count++;
+    return AE_OK;
+}
+
+static
+NTSTATUS
+AcpiEnumCaptureNamespace(
+    ACPI_HANDLE Root,
+    ULONG Flags,
+    PACPI_ENUM_CONTEXT Context)
+{
+    ACPI_STATUS AcpiStatus;
+    ACPI_OBJECT_TYPE Type;
+    UINT32 MaxDepth;
+
+    if (!Context->Filtered)
+    {
+        AcpiStatus = AcpiEnumCaptureObject(Root, 0, Context, NULL);
+        if (ACPI_FAILURE(AcpiStatus))
+            return Context->Status;
+    }
+
+    Type = Context->Filtered ? ACPI_TYPE_ANY : ACPI_TYPE_DEVICE;
+    MaxDepth = (Flags & ENUM_CHILDREN_MULTILEVEL) ? ACPI_UINT32_MAX : 1;
+    AcpiStatus = AcpiWalkNamespace(Type,
+                                   Root,
+                                   MaxDepth,
+                                   AcpiEnumCaptureObject,
+                                   NULL,
+                                   Context,
+                                   NULL);
+    if (ACPI_FAILURE(AcpiStatus))
+    {
+        if (!NT_SUCCESS(Context->Status))
+            return Context->Status;
+        return AcpiStatus == AE_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES
+                                         : STATUS_INVALID_DEVICE_REQUEST;
+    }
+    return STATUS_SUCCESS;
+}
+
+static
+BOOLEAN
+AcpiEnumValidNameSeg(
+    const CHAR Name[ACPI_NAMESEG_SIZE + 1])
+{
+    ULONG Index;
+
+    if (!((Name[0] >= 'A' && Name[0] <= 'Z') || Name[0] == '_') ||
+        Name[ACPI_NAMESEG_SIZE] != ANSI_NULL)
+    {
+        return FALSE;
+    }
+    for (Index = 1; Index < ACPI_NAMESEG_SIZE; Index++)
+    {
+        if (!((Name[Index] >= 'A' && Name[Index] <= 'Z') ||
+              (Name[Index] >= '0' && Name[Index] <= '9') ||
+              Name[Index] == '_'))
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+NTSTATUS
+NTAPI
+Bus_PDO_EnumChildren(
+    _In_ PPDO_DEVICE_DATA DeviceData,
+    _Inout_ PIRP Irp)
+{
+    PIO_STACK_LOCATION IrpStack;
+    PACPI_ENUM_CHILDREN_INPUT_BUFFER Input;
+    PACPI_ENUM_CHILDREN_OUTPUT_BUFFER Output;
+    ACPI_ENUM_CONTEXT Context;
+    ULONG InputLength;
+    ULONG OutputLength;
+    ULONG Flags;
+    ULONG BaseFlags;
+    ULONG Signature;
+    ULONG OutputSignature = ACPI_ENUM_CHILDREN_OUTPUT_BUFFER_SIGNATURE;
+    ULONG NameLength;
+    CHAR Filter[ACPI_NAMESEG_SIZE + 1] = {0};
+    PLIST_ENTRY Link;
+    PACPI_ENUM_ENTRY Entry;
+    PUCHAR Cursor;
+    NTSTATUS Status;
+
+    PAGED_CODE();
+
+    IrpStack = IoGetCurrentIrpStackLocation(Irp);
+    InputLength = IrpStack->Parameters.DeviceIoControl.InputBufferLength;
+    OutputLength = IrpStack->Parameters.DeviceIoControl.OutputBufferLength;
+    Input = Irp->AssociatedIrp.SystemBuffer;
+    Irp->IoStatus.Information = 0;
+    if (!DeviceData->AcpiHandle)
+        return STATUS_INVALID_DEVICE_REQUEST;
+    if (!Input || InputLength < sizeof(ACPI_ENUM_CHILDREN_INPUT_BUFFER))
+        return STATUS_INVALID_PARAMETER;
+
+    Signature = Input->Signature;
+    Flags = Input->Flags;
+    NameLength = Input->NameLength;
+    BaseFlags = Flags & (ENUM_CHILDREN_IMMEDIATE_ONLY | ENUM_CHILDREN_MULTILEVEL);
+    if (Signature != ACPI_ENUM_CHILDREN_INPUT_BUFFER_SIGNATURE ||
+        (Flags & ~ACPI_ENUM_KNOWN_FLAGS) ||
+        (BaseFlags != ENUM_CHILDREN_IMMEDIATE_ONLY &&
+         BaseFlags != ENUM_CHILDREN_MULTILEVEL))
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (Flags & ENUM_CHILDREN_NAME_IS_FILTER)
+    {
+        if (NameLength != sizeof(Filter) ||
+            InputLength < FIELD_OFFSET(ACPI_ENUM_CHILDREN_INPUT_BUFFER, Name) + NameLength)
+        {
+            return STATUS_INVALID_PARAMETER;
+        }
+        RtlCopyMemory(Filter, Input->Name, sizeof(Filter));
+        if (!AcpiEnumValidNameSeg(Filter))
+            return STATUS_INVALID_PARAMETER;
+    }
+
+    if (OutputLength < ACPI_ENUM_OUTPUT_HEADER_SIZE)
+        return STATUS_BUFFER_TOO_SMALL;
+
+    InitializeListHead(&Context.Entries);
+    Context.Status = STATUS_SUCCESS;
+    Context.RequiredLength = ACPI_ENUM_OUTPUT_HEADER_SIZE;
+    Context.Count = 0;
+    Context.Filtered = !!(Flags & ENUM_CHILDREN_NAME_IS_FILTER);
+    RtlCopyMemory(Context.Filter, Filter, sizeof(Filter));
+
+    Status = AcpiEnumCaptureNamespace(DeviceData->AcpiHandle, Flags, &Context);
+    if (!NT_SUCCESS(Status))
+    {
+        AcpiEnumFreeEntries(&Context);
+        return Status;
+    }
+
+    Output = Irp->AssociatedIrp.SystemBuffer;
+    RtlCopyMemory((PUCHAR)Output + FIELD_OFFSET(ACPI_ENUM_CHILDREN_OUTPUT_BUFFER, Signature),
+                  &OutputSignature,
+                  sizeof(OutputSignature));
+    if (OutputLength < Context.RequiredLength)
+    {
+        RtlCopyMemory((PUCHAR)Output +
+                          FIELD_OFFSET(ACPI_ENUM_CHILDREN_OUTPUT_BUFFER, NumberOfChildren),
+                      &Context.RequiredLength,
+                      sizeof(Context.RequiredLength));
+        AcpiEnumFreeEntries(&Context);
+        return STATUS_BUFFER_OVERFLOW;
+    }
+
+    RtlCopyMemory((PUCHAR)Output +
+                      FIELD_OFFSET(ACPI_ENUM_CHILDREN_OUTPUT_BUFFER, NumberOfChildren),
+                  &Context.Count,
+                  sizeof(Context.Count));
+    Cursor = (PUCHAR)Output + ACPI_ENUM_OUTPUT_HEADER_SIZE;
+    for (Link = Context.Entries.Flink;
+         Link != &Context.Entries;
+         Link = Link->Flink)
+    {
+        Entry = CONTAINING_RECORD(Link, ACPI_ENUM_ENTRY, Link);
+        RtlCopyMemory(Cursor + FIELD_OFFSET(ACPI_ENUM_CHILD, Flags),
+                      &Entry->Flags,
+                      sizeof(Entry->Flags));
+        RtlCopyMemory(Cursor + FIELD_OFFSET(ACPI_ENUM_CHILD, NameLength),
+                      &Entry->NameLength,
+                      sizeof(Entry->NameLength));
+        RtlCopyMemory(Cursor + ACPI_ENUM_RECORD_HEADER_SIZE,
+                      Entry->Name,
+                      Entry->NameLength);
+        Cursor += ACPI_ENUM_RECORD_HEADER_SIZE + Entry->NameLength;
+    }
+    NT_ASSERT((ULONG)(Cursor - (PUCHAR)Output) == Context.RequiredLength);
+    Irp->IoStatus.Information = Context.RequiredLength;
+    AcpiEnumFreeEntries(&Context);
+    return STATUS_SUCCESS;
+}
