@@ -470,6 +484,28 @@ EvalCreateParametersList(
             break;
         }
 
+        case ACPI_EVAL_INPUT_BUFFER_SIMPLE_INTEGER_SIGNATURE_EX:
+        {
+            PACPI_EVAL_INPUT_BUFFER_SIMPLE_INTEGER_EX SimpleInt;
+
+            if (!AcpiVerifyInBuffer(IoStack, sizeof(*SimpleInt)))
+            {
+                DPRINT1("Buffer too small\n");
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+
+            Arg = ExAllocatePoolUninitialized(NonPagedPool, sizeof(*Arg), TAG_ACPI_PARAMETERS_LIST);
+            if (!Arg)
+                return STATUS_INSUFFICIENT_RESOURCES;
+
+            ParamList->Count = 1;
+            ParamList->Pointer = Arg;
+            SimpleInt = Irp->AssociatedIrp.SystemBuffer;
+            Arg->Type = ACPI_TYPE_INTEGER;
+            Arg->Integer.Value = SimpleInt->IntegerArgument;
+            break;
+        }
+
         case ACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING_SIGNATURE:
         {
             PACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING SimpleStr;
@@ -495,6 +531,40 @@ EvalCreateParametersList(
             break;
         }
 
+        case ACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING_SIGNATURE_EX:
+        {
+            PACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING_EX SimpleStr;
+            ULONG RequiredLength;
+
+            if (!AcpiVerifyInBuffer(IoStack, sizeof(*SimpleStr)))
+            {
+                DPRINT1("Buffer too small\n");
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+            SimpleStr = Irp->AssociatedIrp.SystemBuffer;
+            if (SimpleStr->StringLength == 0 ||
+                !NT_SUCCESS(RtlULongAdd(FIELD_OFFSET(ACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING_EX,
+                                                    String),
+                                       SimpleStr->StringLength,
+                                       &RequiredLength)) ||
+                !AcpiVerifyInBuffer(IoStack, RequiredLength) ||
+                SimpleStr->String[SimpleStr->StringLength - 1] != ANSI_NULL)
+            {
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+
+            Arg = ExAllocatePoolUninitialized(NonPagedPool, sizeof(*Arg), TAG_ACPI_PARAMETERS_LIST);
+            if (!Arg)
+                return STATUS_INSUFFICIENT_RESOURCES;
+
+            ParamList->Count = 1;
+            ParamList->Pointer = Arg;
+            Arg->Type = ACPI_TYPE_STRING;
+            Arg->String.Pointer = (PCHAR)SimpleStr->String;
+            Arg->String.Length = SimpleStr->StringLength - sizeof(UCHAR);
+            break;
+        }
+
         case ACPI_EVAL_INPUT_BUFFER_COMPLEX_SIGNATURE:
         {
             PACPI_EVAL_INPUT_BUFFER_COMPLEX ComplexBuffer;
@@ -562,6 +632,78 @@ EvalCreateParametersList(
             break;
         }
 
+        case ACPI_EVAL_INPUT_BUFFER_COMPLEX_SIGNATURE_EX:
+        {
+            PACPI_EVAL_INPUT_BUFFER_COMPLEX_EX ComplexBuffer;
+            PACPI_METHOD_ARGUMENT Argument;
+            ULONG i, Length, Offset, ArgumentsSize;
+            NTSTATUS Status;
+
+            if (!AcpiVerifyInBuffer(IoStack, sizeof(*ComplexBuffer)))
+            {
+                DPRINT1("Buffer too small\n");
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+
+            ComplexBuffer = Irp->AssociatedIrp.SystemBuffer;
+            if (ComplexBuffer->Size !=
+                IoStack->Parameters.DeviceIoControl.InputBufferLength)
+            {
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+            ParamList->Count = ComplexBuffer->ArgumentCount;
+            if (ParamList->Count == 0)
+            {
+                DPRINT1("No arguments\n");
+                return STATUS_ACPI_INCORRECT_ARGUMENT_COUNT;
+            }
+
+            Status = RtlULongMult(ParamList->Count, sizeof(*Arg), &ArgumentsSize);
+            if (!NT_SUCCESS(Status))
+                return STATUS_ACPI_INCORRECT_ARGUMENT_COUNT;
+
+            Arg = ExAllocatePoolUninitialized(NonPagedPool,
+                                              ArgumentsSize,
+                                              TAG_ACPI_PARAMETERS_LIST);
+            if (!Arg)
+                return STATUS_INSUFFICIENT_RESOURCES;
+            ParamList->Pointer = Arg;
+            Argument = ComplexBuffer->Argument;
+            Length = FIELD_OFFSET(ACPI_EVAL_INPUT_BUFFER_COMPLEX_EX, Argument);
+
+            for (i = 0; i < ParamList->Count; i++)
+            {
+                ULONG ArgumentLength;
+
+                Offset = Length;
+                ArgumentLength = ACPI_METHOD_ARGUMENT_LENGTH_FROM_ARGUMENT(Argument);
+                if (!NT_SUCCESS(RtlULongAdd(Length, ArgumentLength, &Length)))
+                {
+                    ExFreePoolWithTag(ParamList->Pointer, TAG_ACPI_PARAMETERS_LIST);
+                    return STATUS_ACPI_INVALID_ARGTYPE;
+                }
+                if (!AcpiVerifyInBuffer(IoStack, Length))
+                {
+                    ExFreePoolWithTag(ParamList->Pointer, TAG_ACPI_PARAMETERS_LIST);
+                    return STATUS_ACPI_INVALID_ARGTYPE;
+                }
+                Status = EvalConvertParameterObjects(Arg, 0, Argument, IoStack, Offset);
+                if (!NT_SUCCESS(Status))
+                {
+                    ExFreePoolWithTag(ParamList->Pointer, TAG_ACPI_PARAMETERS_LIST);
+                    return Status;
+                }
+                Arg++;
+                Argument = ACPI_METHOD_NEXT_ARGUMENT(Argument);
+            }
+            if (Length != ComplexBuffer->Size)
+            {
+                ExFreePoolWithTag(ParamList->Pointer, TAG_ACPI_PARAMETERS_LIST);
+                return STATUS_INFO_LENGTH_MISMATCH;
+            }
+            break;
+        }
+
         default:
         {
             DPRINT1("Unsupported input buffer signature: 0x%lx\n", EvalInputBuffer->Signature);
@@ -678,19 +820,67 @@ DefaultStatus:
  * @brief Evaluates an ACPI namespace object.
  */
 static
-ACPI_STATUS
-EvalEvaluateObject(
-    _In_ PPDO_DEVICE_DATA DeviceData,
+BOOLEAN
+EvalIsExtendedSignature(
+    _In_ ULONG Signature)
+{
+    return Signature == ACPI_EVAL_INPUT_BUFFER_SIGNATURE_EX ||
+           Signature == ACPI_EVAL_INPUT_BUFFER_SIMPLE_INTEGER_SIGNATURE_EX ||
+           Signature == ACPI_EVAL_INPUT_BUFFER_SIMPLE_STRING_SIGNATURE_EX ||
+           Signature == ACPI_EVAL_INPUT_BUFFER_COMPLEX_SIGNATURE_EX;
+}
+
+static
+NTSTATUS
+EvalGetMethodName(
+    _In_ PIO_STACK_LOCATION IoStack,
     _In_ PACPI_EVAL_INPUT_BUFFER EvalInputBuffer,
-    _In_ ACPI_OBJECT_LIST* ParamList,
-    _In_ ACPI_BUFFER* ReturnBuffer)
+    _Out_writes_(ACPI_OBJECT_NAME_LENGTH) PCHAR ShortMethodName,
+    _Out_ PCHAR* MethodName)
 {
-    CHAR MethodName[ACPI_OBJECT_NAME_LENGTH];
+    ULONG Index;
 
-    RtlCopyMemory(MethodName, EvalInputBuffer->MethodName, ACPI_OBJECT_NAME_LENGTH - 1);
-    MethodName[ACPI_OBJECT_NAME_LENGTH - 1] = ANSI_NULL;
+    if (EvalIsExtendedSignature(EvalInputBuffer->Signature))
+    {
+        PACPI_EVAL_INPUT_BUFFER_EX ExtendedBuffer;
 
-    return AcpiEvaluateObject(DeviceData->AcpiHandle, MethodName, ParamList, ReturnBuffer);
+        if (!AcpiVerifyInBuffer(IoStack, sizeof(*ExtendedBuffer)))
+            return STATUS_INFO_LENGTH_MISMATCH;
+        ExtendedBuffer = (PACPI_EVAL_INPUT_BUFFER_EX)EvalInputBuffer;
+        for (Index = 0; Index < RTL_NUMBER_OF(ExtendedBuffer->MethodName); Index++)
+        {
+            if (ExtendedBuffer->MethodName[Index] == ANSI_NULL)
+            {
+                if (Index == 0)
+                    return STATUS_INVALID_PARAMETER;
+                *MethodName = ExtendedBuffer->MethodName;
+                return STATUS_SUCCESS;
+            }
+        }
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    if (!AcpiVerifyInBuffer(IoStack, sizeof(*EvalInputBuffer)))
+        return STATUS_INFO_LENGTH_MISMATCH;
+    RtlCopyMemory(ShortMethodName,
+                  EvalInputBuffer->MethodName,
+                  ACPI_OBJECT_NAME_LENGTH - 1);
+    ShortMethodName[ACPI_OBJECT_NAME_LENGTH - 1] = ANSI_NULL;
+    *MethodName = ShortMethodName;
+    return STATUS_SUCCESS;
+}
+
+static
+BOOLEAN
+EvalIoctlMatchesSignature(
+    _In_ ULONG IoControlCode,
+    _In_ ULONG Signature)
+{
+    BOOLEAN ExtendedIoctl;
+
+    ExtendedIoctl = IoControlCode == IOCTL_ACPI_EVAL_METHOD_EX ||
+                    IoControlCode == IOCTL_ACPI_ASYNC_EVAL_METHOD_EX;
+    return ExtendedIoctl == EvalIsExtendedSignature(Signature);
 }
 
 /**
@@ -772,15 +962,35 @@ Bus_PDO_EvalMethod(
     ACPI_STATUS AcpiStatus;
     NTSTATUS Status;
     ACPI_BUFFER ReturnBuffer = { ACPI_ALLOCATE_BUFFER, NULL };
+    CHAR ShortMethodName[ACPI_OBJECT_NAME_LENGTH];
+    PCHAR MethodName;
 
     IoStack = IoGetCurrentIrpStackLocation(Irp);
     EvalInputBuffer = Irp->AssociatedIrp.SystemBuffer;
 
+    if (!EvalInputBuffer ||
+        !AcpiVerifyInBuffer(IoStack, sizeof(EvalInputBuffer->Signature)) ||
+        !EvalIoctlMatchesSignature(IoStack->Parameters.DeviceIoControl.IoControlCode,
+                                   EvalInputBuffer->Signature))
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    Status = EvalGetMethodName(IoStack,
+                               EvalInputBuffer,
+                               ShortMethodName,
+                               &MethodName);
+    if (!NT_SUCCESS(Status))
+        return Status;
+
     Status = EvalCreateParametersList(Irp, IoStack, EvalInputBuffer, &ParamList);
     if (!NT_SUCCESS(Status))
         return Status;
 
-    AcpiStatus = EvalEvaluateObject(DeviceData, EvalInputBuffer, &ParamList, &ReturnBuffer);
+    AcpiStatus = AcpiEvaluateObject(DeviceData->AcpiHandle,
+                                    MethodName,
+                                    &ParamList,
+                                    &ReturnBuffer);
 
     if (ParamList.Count != 0)
         EvalFreeParametersList(&ParamList);
