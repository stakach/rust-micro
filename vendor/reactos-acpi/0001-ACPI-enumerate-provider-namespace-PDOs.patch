+#define ACPI_MAX_INSTANCE_ID_CHARS 199
 
 extern struct acpi_device		*acpi_root;
 
+static
+NTSTATUS
+Bus_AllocateInstanceId(
+    ACPI_HANDLE Handle,
+    PWCHAR *InstanceId)
+{
+    ACPI_BUFFER Path = {ACPI_ALLOCATE_BUFFER, NULL};
+    ACPI_STATUS AcpiStatus;
+    PCSTR Source;
+    SIZE_T SourceLength;
+    SIZE_T Index;
+    PWCHAR Buffer;
+
+    *InstanceId = NULL;
+    AcpiStatus = AcpiGetName(Handle, ACPI_FULL_PATHNAME, &Path);
+    if (ACPI_FAILURE(AcpiStatus) || !Path.Pointer)
+        return AcpiStatus == AE_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES
+                                         : STATUS_INVALID_DEVICE_REQUEST;
+
+    Source = Path.Pointer;
+    SourceLength = strlen(Source);
+    if (SourceLength < 5 ||
+        SourceLength > ACPI_MAX_INSTANCE_ID_CHARS + 1 ||
+        Source[0] != '\\')
+    {
+        AcpiOsFree(Path.Pointer);
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+    for (Index = 1; Index < SourceLength; Index++)
+    {
+        if ((UCHAR)Source[Index] < ' ' ||
+            (UCHAR)Source[Index] > 0x7f ||
+            Source[Index] == ',' ||
+            Source[Index] == '\\')
+        {
+            AcpiOsFree(Path.Pointer);
+            return STATUS_INVALID_DEVICE_REQUEST;
+        }
+    }
+
+    Buffer = ExAllocatePoolWithTag(PagedPool,
+                                   SourceLength * sizeof(WCHAR),
+                                   'IpcA');
+    if (!Buffer)
+    {
+        AcpiOsFree(Path.Pointer);
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    for (Index = 1; Index < SourceLength; Index++)
+        Buffer[Index - 1] = (WCHAR)(UCHAR)Source[Index];
+    Buffer[SourceLength - 1] = UNICODE_NULL;
+    AcpiOsFree(Path.Pointer);
+    *InstanceId = Buffer;
+    return STATUS_SUCCESS;
+}
+
